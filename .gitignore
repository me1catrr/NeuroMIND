# =========================
# NeuroMIND
# Git ignore (Julia + EEG privacy)
# =========================

# --- Sensitive EEG data and generated derivatives ---
/data/
/results/
# Resultados archivados (derivados EEG) — no versionar
/deprecated/
/reports/
/report/
/exports/

# Keep empty directory placeholders if they are added intentionally.
!/data/.gitkeep
!/results/.gitkeep

# --- Local app/editor state (estado interno; los ficheros de reglas sí se trackean) ---
# Claude Code  → .claude/ ignorado; CLAUDE.md trackeado ✓
# Cursor       → .cursor/ ignorado (chat/logs internos); .cursorrules trackeado ✓
# Codex CLI    → sin estado local de proyecto; AGENTS.md trackeado ✓
# Warp         → estado global en ~/.warp/, nada en el proyecto
.claude/
.cursor/
.vscode/
.codex/

# --- Julia artifacts and local caches ---
*.jl.cov
*.jl.*.cov
*.jl.mem
*.ji
*.so
*.dylib
*.dll
*.pdb
*.o
*.a
.julia/

# --- Logs, temporary files, notebooks state ---
*.log
*.tmp
*.temp
*.swp
*~
.cache/
tmp/
temp/
logs/
config/.batch_tmp/
config/results/
wPLI_paper/
__pycache__/
.ipynb_checkpoints/
**/pluto_export/**
**/pluto_state/**
**/.pluto/**

# --- OS files ---
.DS_Store
._*
Thumbs.db

# --- Secrets and credentials ---
.env
.env.*
**/*secret*
**/*secrets*
**/*token*
**/*apikey*
**/*api_key*
