# =========================
# NeuroMIND
# Git ignore (Julia + EEG privacy)
# =========================

# --- Sensitive EEG data and generated derivatives ---
/data/
/results/
# Resultados archivados (derivados EEG, GB) — no versionar.
# Ojo: solo /deprecated/results/. El código archivado (/deprecated/code/)
# SÍ se versiona: son ficheros pequeños cuyo histórico interesa conservar.
/deprecated/results/
/reports/
/report/
/exports/

# Keep empty directory placeholders if they are added intentionally.
!/data/.gitkeep
!/results/.gitkeep

# --- Local app/editor state (estado interno; los ficheros de reglas sí se trackean) ---
# Claude Code  → .claude/ ignorado; CLAUDE.md trackeado ✓
# Cursor       → .cursor/ ignorado (chat/logs internos); .cursorrules trackeado ✓
# Codex CLI    → sin estado local de proyecto; AGENTS.md trackeado ✓
# Warp         → estado global en ~/.warp/, nada en el proyecto
.claude/
.cursor/
.vscode/
.codex/

# --- Julia artifacts and local caches ---
*.jl.cov
*.jl.*.cov
*.jl.mem
*.ji
*.so
*.dylib
*.dll
*.pdb
*.o
*.a
.julia/

# --- Logs, temporary files, notebooks state ---
*.log
*.tmp
*.temp
*.swp
*~
.cache/
tmp/
temp/
logs/
config/.batch_tmp/
config/results/
wPLI_paper/
__pycache__/
.ipynb_checkpoints/
**/pluto_export/**
**/pluto_state/**
**/.pluto/**

# --- OS files ---
.DS_Store
._*
Thumbs.db

# --- Secrets and credentials ---
.env
.env.*
**/*secret*
**/*secrets*
**/*token*
**/*apikey*
**/*api_key*

# --- graphify (grafo versionado para compartirlo entre ordenadores) ---
# Se versionan graph.json, GRAPH_REPORT.md, graph.html, manifest y cache/
# (la caché semántica evita repetir la extracción con LLM en el otro equipo).
# Solo se ignora lo que depende de la máquina o de una ejecución concreta:
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_cached.json
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_semantic*.json
graphify-out/.graphify_extract*.json
# Índice de mtimes por máquina (cambia en cada commit; no es portable)
graphify-out/cache/stat-index.json
# Copias de seguridad automáticas que graphify hace antes de reescribir el grafo
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
