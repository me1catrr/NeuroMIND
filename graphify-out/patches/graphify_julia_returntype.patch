+
+    def _unwrap_call(node):
+        """Peel `f(x)::T` (typed_expression) and `f(x) where {T}` (where_expression)
+        wrappers down to the underlying call_expression, if any."""
+        while node is not None and node.type in ("typed_expression", "where_expression") and node.children:
+            node = node.children[0]
+        return node
 
