{"nodes": [{"id": "docs_tdd_ejecucion_rutinas", "label": "TDD \u2014 Sistema de ejecuci\u00f3n de rutinas", "file_type": "document", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null}, {"id": "docs_tdd_ejecucion_rutinas_clean_slate_per_leaf_unit", "label": "Clean-slate per leaf unit + manifest", "file_type": "rationale", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Overwrite-only leaves orphan files after renames (the _EC suffix/legacy tree problem). Deleting all results/ breaks batch; per-run folders break stable paths. Each unit (subject/session/task or group condition) wipes only its own folder, mirroring Snakemake/Nextflow output ownership. Global indices are upserted, never deleted."}, {"id": "docs_tdd_ejecucion_rutinas_atomic_staging", "label": "Atomic staging directory ({unit}.tmp/ + mv swap)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "mv within the same filesystem is atomic: either the new complete version or the old one, never a half state if the process dies."}, {"id": "docs_tdd_ejecucion_rutinas_safe_clean", "label": "_safe_clean path guard", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Abort deletion unless realpath starts with results/subjects|transversal|longitudinal, preventing rm -rf from a malformed subject_id."}, {"id": "docs_tdd_ejecucion_rutinas_run_manifest_json", "label": "run_manifest.json (per execution unit)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "JSON over TXT/TOML so manifests of 205 recordings can be aggregated with jq. git_dirty and config.sha256 are the key reproducibility guards. Complements (does not replace) config_snapshot.toml and pipeline_log.txt."}, {"id": "docs_tdd_ejecucion_rutinas_leaf_unit_folder_layout", "label": "Leaf-unit layout tables/ figures/ json/ (+ connectivity/)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a73.1", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Three fixed type categories; a phase subfolder only where volume justifies it (connectivity: wPLI x4 variants x7 bands + surrogates). Per-phase folders rejected because they create single-file folders."}, {"id": "docs_tdd_ejecucion_rutinas_runtime_layer", "label": "src/runtime/ execution layer", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Cross-cutting I/O + presentation layer shared by the four routines; scientific core (ICA, wPLI) untouched. No new dependencies: ProgressMeter, Crayons, PrettyTables, LoggingExtras already in Manifest.toml. Proposal, not implemented."}, {"id": "docs_tdd_ejecucion_rutinas_runcontext", "label": "RunContext", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Single source of truth for manifest and on-screen summary."}, {"id": "docs_tdd_ejecucion_rutinas_resultsmanager", "label": "ResultsManager", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null}, {"id": "docs_tdd_ejecucion_rutinas_runmanifest", "label": "RunManifest module", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null}, {"id": "docs_tdd_ejecucion_rutinas_runlogging", "label": "RunLogging (LoggingExtras TeeLogger)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "println status is lost; TeeLogger sends console (Info, colored) and results/logs/run_{timestamp}.log (Debug, plain) simultaneously; one file per run instead of size rotation."}, {"id": "docs_tdd_ejecucion_rutinas_console", "label": "Console (Crayons, TTY/ASCII degradation)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a74.4, \u00a77", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null, "rationale": "Four semantic levels only; disable ANSI when not a TTY to keep logs/CI clean; monochrome Unicode icons, no emojis for scientific sobriety."}, {"id": "docs_tdd_ejecucion_rutinas_preflight", "label": "Preflight checks (fail early)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null}, {"id": "docs_tdd_ejecucion_rutinas_progress", "label": "Progress (ProgressMeter)", "file_type": "concept", "source_file": "docs/TDD_ejecucion_rutinas.md", "source_location": "\u00a74.3", "source_url": null, "captured_at": null, "author": "Rafael Castro Triguero", "contributor": null}, {"id": "docs_tdd_ejecucion_rutinas_summary", "label": "Summary (final b